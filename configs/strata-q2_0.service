[Unit]
Description=Strata Qwen3.8-Flash-Next Q2_0 on 2x P100 (self-built sm_60 engine)
After=network.target

[Service]
Type=simple
User=CHANGEME
WorkingDirectory=/home/CHANGEME
Environment=PATH=/home/CHANGEME/.local/bin:/usr/local/bin:/usr/bin:/bin
# --parallel 1 is the fastest single-user config on 2x16 GB: two slots at 128K cost 24%
# (two KV caches squeeze the expert cache). Raise it only together with a smaller context.
ExecStart=/home/CHANGEME/.local/bin/strata serve --profile /home/CHANGEME/profiles/q2_0.json --host 0.0.0.0 --port 8080
Restart=always
RestartSec=15
TimeoutStopSec=120
KillMode=mixed

[Install]
WantedBy=multi-user.target
